date-released: "2026-10-11"
license: Apache-2.0
repository-code: "https://github.com/zachshallbetter/IEPE"
url: "https://github.com/zachshallbetter/IEPE"
keywords:
  - intent and evidence
  - project engine
  - agent governance
  - ticket-first engineering
  - evidence qualification
  - software process
  - autonomous agents
  - protocol
